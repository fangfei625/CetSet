#now in R

# 1. Setting up workspace -------------------------------------------------
setwd("/nesi/nobackup/uoa02626/cetsetredo/AG1515/samples")
getwd()

# List of required packages

library("writexl")
library("dada2")
library("ggplot2")
library("reshape2")
library("dplyr")
library("stringi")


# 2. Organise your files --------------------------------------------------
miseq_path <- file.path("/nesi/nobackup/uoa02626/cetsetredo/AG1515/samples") #change this to your path with fastq files

# Sort ensures forward/reverse reads are in same order
fnFs <- sort(list.files("/nesi/nobackup/uoa02626/cetsetredo/AG1515/samples", pattern="_R1.clean_repair.fastq", full.names = TRUE))
fnRs <- sort(list.files("/nesi/nobackup/uoa02626/cetsetredo/AG1515/samples", pattern="_R2.clean_repair.fastq", full.names = TRUE))

# Extract sample names, assuming filenames have format: Cet_Set_2.AG1515_007
sampleNames <- sapply(strsplit(fnFs, "_"), function(x) paste(x[3], x[4], sep="_")) #assumes that whatever after the third _ is the sample name, e.g.Cet_Set_2.AG1515_007
sampleNames
length(sampleNames)
sampleNames[duplicated(sampleNames)] # check for duplicates

valid_fwd <- file.info(fnFs)$size > 0 #assigning sequences with a size larger than 0
valid_fwd
valid_rev <- file.info(fnRs)$size > 0
valid_rev
valid <- c(valid_fwd & valid_rev)
valid
fnFs <- fnFs[valid] #rewriting fnfs and fnrs with only values above 0, e.g. dropping any samples with 0 sequences
fnRs <- fnRs[valid]

#check none are a size of 0
file.info(fnFs)$size
file.info(fnRs)$size

sampleNames <- sampleNames[valid]
sampleNames

filt_path <- file.path("/nesi/nobackup/uoa02626/cetsetredo/AG1515/samples") # Place filtered files in filtered/ subdirectory

if(!file_test("-d", filt_path)) dir.create(filt_path)
filtFs <- file.path(filt_path, paste0(sampleNames, "_F_filt.fastq.gz"))
filtFs
filtRs <- file.path(filt_path, paste0(sampleNames, "_R_filt.fastq.gz"))
filtRs

# Check forward reads
missing_fnFs <- fnFs[!file.exists(fnFs)]
# Check reverse reads
missing_fnRs <- fnRs[!file.exists(fnRs)]

# Print missing files
missing_fnFs
missing_fnRs

length(fnFs) == length(filtFs)
length(fnRs) == length(filtRs)

#checking the number of reads in each f and r sequence match
library(ShortRead)
fcheck <- sapply(fnFs, function(f) countLines(f)/4)
rcheck <- sapply(fnRs, function(f) countLines(f)/4)
matched <- fcheck == rcheck
matched[matched == FALSE] #these are the ones that dont match!

fnFs <- fnFs[matched]
fnRs <- fnRs[matched]
filtFs <- filtFs[matched]
filtRs <- filtRs[matched]

#check they all match
length(fnFs)
length(filtFs)
length(fnRs)
length(filtRs)

any(duplicated(filtFs))
any(duplicated(filtRs))
any(duplicated(fnFs))
any(duplicated(fnRs))
save.image(file = "dada2RData")

# save plots # note - if just using NESI interactive mode these  need to be imported into another environment to view
F <- plotQualityProfile(fnFs, aggregate = TRUE)
ggsave("forward_quality.pdf")
R <- plotQualityProfile(fnRs, aggregate = TRUE)
ggsave("reverse_quality.pdf")

# 3. Filter and trim ------------------------------------------------------

out <- filterAndTrim(fnFs, filtFs, fnRs, filtRs, # enforce consistent read lengths
                     maxN=0,
                     maxEE=2,
                     truncQ=10,
                     rm.phix=TRUE,
                     compress=FALSE,
                     minLen=50,
                     multithread=3)
head(out)
outdf <- as.data.frame(out)
write_xlsx(outdf, path = "readsfilterandtrim.xlsx")

ob <- as.data.frame(out)
new_out <- ob[ob$reads.out == 0, ]

save.image(file = "dada2_a_0.RData")


# 4. Dereplicate ----------------------------------------------------------

filtFs <- file.path(filt_path, (sort(list.files(filt_path, pattern="_F_filt.fastq.gz")))) #finding files and ensures files are alphabetically ordered
filtRs <- file.path(filt_path, (sort(list.files(filt_path, pattern="_R_filt.fastq.gz"))))
filtFs
filtRs
derepFs <- derepFastq(filtFs, verbose=FALSE) #dereplicating means collapsing identical sequencing reads into unique sequences and the number of times this sequence was seen
derepRs <- derepFastq(filtRs, verbose=FALSE)

# Name the derep-class objects by the sample names
f <- sort(list.files("/nesi/nobackup/uoa02626/cetsetredo/AG1515/samples", pattern="F_filt.fastq.gz"))
length(f)
r <- sort(list.files("/nesi/nobackup/uoa02626/cetsetredo/AG1515/samples", pattern="R_filt.fastq.gz"))
length(r)

F_sampleNames <- paste(sapply(strsplit(f, "_"), `[`, 1), sapply(strsplit(f, "_"), `[`, 2), sep="_")
F_sampleNames
R_sampleNames <- paste(sapply(strsplit(r, "_"), `[`, 1), sapply(strsplit(r, "_"), `[`, 2), sep="_")
R_sampleNames

#you can't just assign samplenames to the filtered derep files because some of them have been dropped
#so the below code is just to name the dereps with the filtered ones so that they match
f_valid_samples <- F_sampleNames[!(F_sampleNames %in% rownames(new_out))]
f_valid_samples
r_valid_samples <- R_sampleNames[!(R_sampleNames %in% rownames(new_out))]
r_valid_samples

file.exists(filtFs)
file.exists(filtRs)

filtFs <- file.path(filt_path, paste0(f_valid_samples, "_F_filt.fastq.gz"))
head(filtFs)
filtRs <- file.path(filt_path, paste0(r_valid_samples, "_R_filt.fastq.gz"))
head(filtRs)

derepFs <- derepFastq(filtFs)
names(derepFs) <- f_valid_samples
derepFs
derepRs <- derepFastq(filtRs)
names(derepRs) <- r_valid_samples


# 5. Error modelling ------------------------------------------------------

errF <- learnErrors(filtFs, multithread=TRUE)
errR <- learnErrors(filtRs, multithread=TRUE)

# save plots # note - if just using NESI interactive mode these  need to be imported into another environment to view
erF_plot <- plotErrors(errF)
ggsave("erF_plot.pdf")
erR_plot <- plotErrors(errR)
ggsave("erR_plot.pdf")

# Clean forward read names
names(derepFs) <- sub("_F_filt\\.fastq\\.gz$", "", names(derepFs))

# Clean reverse read names
names(derepRs) <- sub("_R_filt\\.fastq\\.gz$", "", names(derepRs))

#processing dada in batches
sample_names <- names(derepFs)
batch_size <- 200
batches <- split(sample_names, ceiling(seq_along(sample_names) / batch_size))

dadaFs_list <- list()
dadaRs_list <- list()

for (i in seq_along(batches)) {
  batch <- batches[[i]]
  cat("Processing batch", i, "with", length(batch), "samples\n")
  
  derepFs_batch <- derepFs[batch]
  derepRs_batch <- derepRs[batch]
  
  dadaFs_batch <- dada(derepFs_batch, err=errF, pool=TRUE, multithread=4)
  dadaRs_batch <- dada(derepRs_batch, err=errR, pool=TRUE, multithread=4)
  
  dadaFs_list[[i]] <- dadaFs_batch
  dadaRs_list[[i]] <- dadaRs_batch
}

# Combine results
dadaFs <- do.call(c, dadaFs_list)
dadaRs <- do.call(c, dadaRs_list)

# Inspect the dada-class object
dadaFs[[1]]
dadaRs[[1]]

save.image(file = "dada2RData")
# 6. Construct sequence table ---------------------------------------------

mergers <- mergePairs(dadaFs, derepFs, dadaRs, derepRs, trimOverhang=TRUE) #merged forward and reverse reads and trimming overlap hangs
head(mergers) #mergers is a list of merged reads for each sample
seqtabAll <- makeSequenceTable(mergers[!grepl("Mock", names(mergers))]) #rows is samples, columns are ASVs and entries is number of times each asv was observed per sample
table(nchar(getSequences(seqtabAll))) #qual check to count lengths 
seqtabAll <- as.data.frame(t(seqtabAll))

#count asvs per sample - vector that shows number of unique asvs per sample
apply(seqtabAll,1,function(x){sum(x>0)}) 
# rm(mergers, dadaFs, dadaRs, derepFs, derepRs, out, errR, errF, ob, x) # create some room

seqtabAll <- seqtabAll[, nchar(colnames(seqtabAll)) > 50] # delete short DNA strings

save.image(file = "dada2_b.RData") #saves the current r environment
# load(file = "dada2_b.RData")

# 7. Sequence quality control ---------------------------------------------
getN <- function(x) sum(getUniques(x))
track <- cbind(out, sapply(dadaFs, getN), sapply(dadaRs, getN), sapply(mergers, getN))
# If processing a single sample, remove the sapply calls: e.g. replace sapply(dadaFs, getN) with getN(dadaFs)
colnames(track) <- c("input", "filtered", "denoisedF", "denoisedR", "merged")
rownames(track) <- sampleNames
head(track)
track <- as.data.frame(track)
write_xlsx(track, path = "ag1515_track.xlsx")

# Convert the result back to a data frame
seqtabAll <- as.data.frame(t(seqtabAll))
seqtabAll_backup<-seqtabAll
colnames(seqtabAll)<-paste0("ASV_",1:ncol(seqtabAll))
seqtabAll$Sample<-rownames(seqtabAll)
seqtabAll_lf<-reshape2::melt(seqtabAll)
seqtabAll_lf<-cbind(seqtabAll_lf,reshape2::melt(seqtabAll_backup))
colnames(seqtabAll_lf)<-c("Sample","ASV","Count","Seq","Count2")
seqtabAll_lf$Count2<-NULL
seqtabAll_lf<-seqtabAll_lf[seqtabAll_lf$Count>0,]
seqtabAll_lf$Primer<-paste0("CS_",stringr::word(seqtabAll_lf$Sample,1,sep="[.]"))
seqtabAll_lf$SeqName<-paste(">",stringr::word(seqtabAll_lf$Sample,2,sep="[.]"),seqtabAll_lf$Primer,seqtabAll_lf$ASV,seqtabAll_lf$Count,sep="_")
# Split the long-format table by Primer
primer_groups <- split(seqtabAll_lf, seqtabAll_lf$Primer)

# Loop through each primer group and write a FASTA file
for (p in names(primer_groups)) {
  
  df <- primer_groups[[p]]
  
  # Create FASTA lines
  fasta_lines <- paste0(df$SeqName, "\n", df$Seq)
  
  # File name based on primer
  file_name <- paste0(p, "_ASVs.fasta")
  
  # Write file
  writeLines(fasta_lines, con = file_name)
}
