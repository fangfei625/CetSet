#unzipping the fastq files
gunzip_func(){
for f in "$@"
    do
    gunzip "$f"
    done
}
 export function
export -f gunzip_func

## run function in parallel
module load Parallel/20210422 # load gnu-parallel
parallel -j 100% --line-buffer gunzip_func ::: *.gz
