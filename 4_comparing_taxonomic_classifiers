# Deepest rank each method got right (0 = nothing right, 6 = species right).
correct_depth <- function(df, prefix) {
  flags <- as.matrix(df[paste0(prefix, "_correct_", ranks)])
  apply(flags, 1, function(row) {
    wrong <- which(!row)
    if (length(wrong) == 0) length(row) else min(wrong) - 1
  })
}
