last_word <- function(x) sub(".*\\s", "", trimws(x))

lca_of <- function(df, rank_cols) {
  result <- list()
  agree <- TRUE
  for (r in rank_cols) {
    vals <- unique(na.omit(df[[r]]))
    if (agree && length(vals) <= 1) {
      result[[r]] <- if (length(vals) == 1) vals else NA_character_
    } else {
      agree <- FALSE
      result[[r]] <- NA_character_
    }
  }
  as_tibble(result)
}

correct_depth <- function(df, prefix, ranks) {
  flags <- as.matrix(df[paste0(prefix, "_correct_", ranks)])
  apply(flags, 1, function(row) {
    wrong <- which(!row)
    if (length(wrong) == 0) length(row) else min(wrong) - 1
  })
}

run_set_comparison <- function(set) {
  message("=== ", set, " ===")
  
  bayesant <- read_rds(file.path("bayesant_results", paste0(set, "_DB_derep_LOO_ASVs_bayesant.RDS")))
  dada2    <- read_csv(file.path("dada2_results", paste0(set, "_DB_derep_LOO_ASVs_assignTaxonomy.csv")),
                       show_col_types = FALSE)
  database <- read_tsv(file.path("..", paste0(set, "_DB_derep_full_curation.txt")), col_names = FALSE,
                       show_col_types = FALSE)
  colnames(database) <- c("accession", "listed_spec", "taxid", "superkingdom", "phylum",
                          "class", "order", "family", "genus", "species", "Sequence")
  
  blast <- read_tsv(file.path("blast_results", paste0(set, "_DB_derep_LOO_ASVs_blast.tsv")),
                    show_col_types = FALSE)
  colnames(blast) <- c("qseqid", "sseqid", "staxids", "pident", "length",
                       "mismatch", "gapopen", "qstart", "qend", "sstart", "send",
                       "evalue", "bitscore", "qlen")
  blast$accession <- blast$qseqid
  blast <- left_join(blast, database, by = "accession")
  
  blast_tbl <- blast %>% rename_with(~ paste0("blast_", .))
  blast_tbl$ASV_ID <- blast_tbl$blast_accession
  
  blast_ranks <- c("blast_order", "blast_family", "blast_genus", "blast_species")
  
  lca_hit <- blast_tbl %>%
    group_by(ASV_ID) %>%
    filter(blast_bitscore >= 0.9 * max(blast_bitscore)) %>%
    group_modify(~ lca_of(.x, blast_ranks)) %>%
    ungroup() %>%
    rename_with(~ paste0("lca_", sub("^blast_", "", .)), all_of(blast_ranks))
  
  best_hit <- blast_tbl %>%
    group_by(ASV_ID) %>%
    slice_max(blast_bitscore, n = 1, with_ties = FALSE) %>%
    ungroup() %>%
    dplyr::select(ASV_ID, all_of(blast_ranks)) %>%
    rename_with(~ paste0("besthit_", sub("^blast_", "", .)), all_of(blast_ranks))
  
  dada2_tbl <- dada2 %>%
    rename(ASV_ID = `...1`) %>%
    rename_with(~ paste0("dada2_", .), -ASV_ID)
  dada2_tbl$dada2_Species <- gsub("_", " ", dada2_tbl$dada2_Species)
  
  bayesant_tbl <- bayesant$prediction %>%
    dplyr::select(Phylum, Class, Order, Family, Genus, Species) %>%
    rename_with(~ paste0("bayesant_", .)) %>%
    mutate(ASV_ID = dada2_tbl$ASV_ID)   # same row order as dada2_tbl
  
  truth_tbl <- database %>%
    dplyr::select(ASV_ID = accession, Phylum = phylum, Class = class, Order = order,
                  Family = family, Genus = genus, Species = species) %>%
    rename_with(~ paste0("true_", .), -ASV_ID)
  
  colnames(bayesant_tbl) <- tolower(colnames(bayesant_tbl))
  colnames(dada2_tbl)    <- tolower(colnames(dada2_tbl))
  colnames(truth_tbl)    <- tolower(colnames(truth_tbl))
  colnames(best_hit)     <- tolower(colnames(best_hit))
  colnames(lca_hit)      <- tolower(colnames(lca_hit))
  
  comparison <- dada2_tbl %>%
    left_join(bayesant_tbl, by = "asv_id") %>%
    left_join(lca_hit, by = "asv_id") %>%
    left_join(best_hit, by = "asv_id") %>%
    left_join(truth_tbl, by = "asv_id")
  
  ranks   <- c("order", "family", "genus", "species")
  methods <- c("dada2", "bayesant", "besthit", "lca")
  
  for (r in ranks) {
    true_col  <- comparison[[paste0("true_", r)]]
    dada2_col <- comparison[[paste0("dada2_", r)]]
    bayes_col <- comparison[[paste0("bayesant_", r)]]
    lca_col   <- comparison[[paste0("lca_", r)]]
    best_col  <- comparison[[paste0("besthit_", r)]]
    
    if (r == "species") {
      true_col  <- last_word(true_col)
      dada2_col <- last_word(dada2_col)
      bayes_col <- last_word(bayes_col)
      lca_col   <- last_word(lca_col)
      best_col  <- last_word(best_col)
    }
    
    comparison[[paste0("dada2_correct_", r)]]    <- !is.na(dada2_col) & dada2_col == true_col
    comparison[[paste0("bayesant_correct_", r)]] <- !is.na(bayes_col) & bayes_col == true_col
    comparison[[paste0("besthit_correct_", r)]]  <- !is.na(best_col) & best_col == true_col
    comparison[[paste0("lca_correct_", r)]]      <- !is.na(lca_col) & lca_col == true_col
  }
  
  depth_cols <- paste0(methods, "_depth")
  for (m in methods) {
    comparison[[paste0(m, "_depth")]] <- correct_depth(comparison, m, ranks)
  }
  
  comparison <- comparison %>%
    rowwise() %>%
    mutate(
      min_depth    = min(c_across(all_of(depth_cols))),
      max_depth    = max(c_across(all_of(depth_cols))),
      depth_spread = max_depth - min_depth
    ) %>%
    ungroup() %>%
    arrange(min_depth, desc(depth_spread))
  
  # accuracy_summary <- sapply(ranks, function(r) {
  #   sapply(methods, function(m) mean(comparison[[paste0(m, "_correct_", r)]]))
  # })
  ## ---- Long-format correctness table, family kept as a grouping column -----
  correct_long <- comparison %>%
    dplyr::select(asv_id, true_family, matches(paste0("^(", paste(methods, collapse = "|"),
                                                      ")_correct_(", paste(ranks, collapse = "|"), ")$"))) %>%
    pivot_longer(
      cols = -c(asv_id, true_family),
      names_to = c("method", "rank"),
      names_pattern = "(.*)_correct_(.*)",
      values_to = "correct"
    )
  
  overall_accuracy <- correct_long %>%
    group_by(method, rank) %>%
    summarise(accuracy = mean(correct), n = n(), .groups = "drop")
  
  family_accuracy <- correct_long %>%
    group_by(true_family, method, rank) %>%
    summarise(accuracy = mean(correct), n = n(), .groups = "drop")
  
  depth_rank <- sort(colMeans(comparison[depth_cols]), decreasing = TRUE)
  
  # list(comparison = comparison, accuracy = accuracy_summary, depth_rank = depth_rank)
  list(comparison = comparison, accuracy = overall_accuracy,
       family_accuracy = family_accuracy, depth_rank = depth_rank)
  
}

