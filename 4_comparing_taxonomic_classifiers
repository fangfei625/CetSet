suppressMessages({
  library(dada2)
  library(BayesANT)
  library(Biostrings)
  library(readr)
})

sets <- c("Set0", "Set1", "Set2", "Set3")

# Must match the --ranks order used when the source sequences were imported
# into CRABS (see run_cetset_pipeline.sh: 'superkingdom;phylum;class;order;family;genus;species').
rank_names <- c("Superkingdom", "Phylum", "Class", "Order", "Family", "Genus", "Species")

n_threads <- 4

dir.create("dada2_results", showWarnings = FALSE)
dir.create("bayesant_results", showWarnings = FALSE)

for (set in sets) {
  
  asv_matches <- Sys.glob(file.path(".", paste0(set, "_*.fasta")))
  if (length(asv_matches) == 0) {
    message("No ASV file for ", set, " matching ./", set, "_*.fasta, skipping.")
    next
  }
  
  ## ---- BayesANT training (once per set, reused for every ASV file) --------
  # Training is set-level (depends only on the reference, not the query), so
  # it's wasteful to redo it once per ASV file when a set has several -- do
  # it once here and reuse the fitted classifier below.
  message("=== ", set, ": training BayesANT classifier ===")
  bayesant_ref <- file.path("bayesant_db", paste0(set, "_bayesant.fasta"))
  
  train_data <- read.BayesANT.data(
    fasta.file = bayesant_ref,
    rank = length(rank_names),
    rank_names = rank_names
  )
  
  # ASV references aren't a multiple-sequence alignment, so use BayesANT's
  # k-mer ("not aligned") kernel rather than its aligned/site-based one.
  classifier <- BayesANT(
    data = train_data, typeseq = "not aligned",
    kmers = 6, newtaxa = TRUE, verbose = TRUE
  )
  
  tax_ref <- file.path("dada2_db", paste0(set, "_dada2_taxonomy.fasta"))
  species_ref <- file.path("dada2_db", paste0(set, "_dada2_species.fasta"))
  
  for (asv_fasta in asv_matches) {
    tag <- tools::file_path_sans_ext(basename(asv_fasta))   # e.g. Set0_ASVs, Set0_eDNA_ASVs
    message("--- ", tag, " ---")
    
    asvs <- readDNAStringSet(asv_fasta)
    asv_seqs <- as.character(asvs)
    
    ## ---- assignTaxonomy (DADA2) ---------------------------------------------
    message("=== ", tag, ": assignTaxonomy ===")
    taxa <- assignTaxonomy(asv_seqs, refFasta = tax_ref, multithread = n_threads, tryRC = TRUE)
    
    #if (file.exists(species_ref)) {
    #  taxa <- addSpecies(taxa, species_ref, tryRC = TRUE)
    #}
    rownames(taxa) <- names(asvs)
    write.csv(taxa, file.path("dada2_results", paste0(tag, "_assignTaxonomy.csv")))
    
    ## ---- BayesANT (predict only -- classifier already trained above) --------
    message("=== ", tag, ": BayesANT ===")
    query <- read.BayesANT.testDNA(asv_fasta)
    result <- predict(
      classifier, DNA = query, rho = 0.1,
      return_probs = TRUE, n_top_taxa = 3, cores = n_threads
    )
    
    write_rds(result, file.path("bayesant_results", paste0(tag, "_bayesant.RDS")))
  }
}

message("Done. DADA2 results in ./dada2_results/, BayesANT results in ./bayesant_results/")

