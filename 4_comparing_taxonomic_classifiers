CS0_comparison$lca_depth    <- correct_depth(CS0_comparison, "lca")
CS0_comparison$besthit_depth <- correct_depth(CS0_comparison, "besthit")

## ---- Sort: worst-overall calls first, biggest method disagreement next ----
