library(tidyverse)
library(ggnewscale)

#1. function for blasting dataframe ----------------------------------------------------
#this takes your blast file and then the database
generate_ani_data <- function(blast_file, database) {
  
  blast_file <- read_delim(blast_file)
  database   <- read_delim(database)
  
  colnames(blast_file) <- c("Query","Subject","PercentID","alignment_length",
                            "mismatches","gap_openings","query_start","query_end",
                            "subject_start","subject_end","Evalue","bitscore","qlen")
  
  blast_file$Accession <- sub("^[^|]*\\|", "", blast_file$Subject)
  blast_file$Accession <- gsub("[|]", "", blast_file$Accession)
  
  # Your database has 10 columns — do NOT delete column 11
  colnames(database) <- c("Accession","Species_FromName","Number","Domain","Phylum",
                          "Class","Order","Family","Genus","Species", "Sequence")
  
  database <- as.data.frame(database)
  database <- dplyr::distinct(database, Accession, .keep_all = TRUE)
  
  merged_acc_blastdf <- dplyr::left_join(blast_file, database, by = "Accession")
  return(merged_acc_blastdf)
}

